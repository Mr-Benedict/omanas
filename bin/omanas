#!/usr/bin/env python3
"""Omanas — Synology DSM client for the Omarchy bar plugin.

The QML side never speaks to the NAS and never holds a credential. It runs
this helper and reads JSON off stdout. That split is deliberate: Omarchy's
shell hosts every third-party plugin in one QML scene that plugins can walk,
so a password or session id living in a QML property would be reachable by
any other installed plugin. Here it is confined to a short-lived process.

Standard library only, so the plugin installs by cloning and nothing else.
"""

from __future__ import annotations

import argparse
import base64
import hashlib
import json
import os
import socket
import ssl
import subprocess
import sys
import time
import http.client
import urllib.error
import urllib.parse
import urllib.request

CONFIG_DIR = os.path.expanduser("~/.config/omanas")
CONFIG_PATH = os.path.join(CONFIG_DIR, "config.json")
CACHE_DIR = os.path.expanduser("~/.cache/omanas")
SESSION_PATH = os.path.join(CACHE_DIR, "session.json")
DNS_PATH = os.path.join(CACHE_DIR, "dns.json")
APIS_PATH = os.path.join(CACHE_DIR, "apis.json")

KEYRING_SERVICE = "omanas"
SESSION_NAME = "Omanas"

# DSM error codes worth translating. Everything else surfaces as its number,
# because DSM's own catalogue is inconsistent between APIs.
AUTH_ERRORS = {
    400: "Wrong username or password",
    401: "Account disabled",
    402: "Permission denied",
    403: "Two-factor code required",
    404: "Two-factor code is wrong",
    406: "Two-factor is enforced for this account",
    407: "Blocked by IP auto-block",
    408: "Password expired and must be changed in DSM",
    409: "Password expired",
    410: "Password must be changed",
    411: "Account locked",
}
# SYNO.Core.Share.Crypto reports in its own range rather than the common one.
CRYPTO_ERRORS = {
    3308: "Wrong encryption passphrase",
    3309: "The shared folder is already unlocked",
    3310: "No such encrypted shared folder",
}

COMMON_ERRORS = {
    100: "Unknown error",
    101: "Invalid parameter",
    102: "The requested API does not exist",
    103: "The requested method does not exist",
    104: "This API version is not supported",
    105: "Insufficient user privilege",
    106: "Session timeout",
    107: "Session interrupted by a duplicate login",
    119: "Session expired",
}


class DsmError(Exception):
    """A DSM API call came back with success=false."""

    def __init__(self, code: int, api: str = "", method: str = ""):
        self.code = int(code)
        self.api = api
        self.method = method
        super().__init__(self.describe())

    def describe(self) -> str:
        text = (AUTH_ERRORS.get(self.code) or CRYPTO_ERRORS.get(self.code)
                or COMMON_ERRORS.get(self.code))
        where = f" ({self.api}.{self.method})" if self.api else ""
        return f"{text}{where}" if text else f"DSM error {self.code}{where}"


# ---------------------------------------------------------------- config


# DSM listens for plain HTTP on 5000 and HTTPS on 5001, and mixing them up is
# the easiest mistake to make on this form. OpenSSL's own words for it
# ("wrong version number") describe the packet, not the problem, so both
# directions get translated into what to actually change.
HTTP_PORT = 5000
HTTPS_PORT = 5001


def describe_tls_failure(exc: Exception, port: int) -> str:
    text = str(exc)
    if "WRONG_VERSION_NUMBER" in text or "UNEXPECTED_MESSAGE" in text or "record layer" in text:
        if int(port) == HTTP_PORT:
            return (f"Port {HTTP_PORT} is DSM's plain HTTP port, so it cannot answer HTTPS. "
                    f"Use port {HTTPS_PORT}, or turn HTTPS off (your password would then "
                    "cross the network unencrypted).")
        return (f"Port {port} is not speaking HTTPS. Try DSM's HTTPS port ({HTTPS_PORT}), "
                "or turn HTTPS off.")
    if "CERTIFICATE_VERIFY_FAILED" in text:
        return "The NAS certificate could not be verified."
    return f"TLS handshake failed: {text}"


def load_config() -> dict:
    try:
        with open(CONFIG_PATH, encoding="utf-8") as handle:
            return json.load(handle)
    except FileNotFoundError:
        return {}
    except (OSError, ValueError) as exc:
        raise SystemExit(f"Cannot read {CONFIG_PATH}: {exc}")


def save_config(config: dict) -> None:
    os.makedirs(CONFIG_DIR, mode=0o700, exist_ok=True)
    tmp = CONFIG_PATH + ".tmp"
    with open(tmp, "w", encoding="utf-8") as handle:
        json.dump(config, handle, indent=2, sort_keys=True)
        handle.write("\n")
    os.chmod(tmp, 0o600)
    os.replace(tmp, CONFIG_PATH)


# --------------------------------------------------------------- secrets
#
# secret-tool rather than a Python binding, so the helper keeps its
# no-dependency promise. Secrets cross as stdin/stdout between two local
# processes and never appear in argv, where any user on the box could read
# them out of /proc.


def secret_attrs(config: dict, kind: str) -> list[str]:
    return [
        "service", KEYRING_SERVICE,
        "host", str(config.get("host", "")),
        "account", str(config.get("username", "")),
        "kind", kind,
    ]


def secret_store(config: dict, kind: str, value: str, label: str) -> None:
    subprocess.run(
        ["secret-tool", "store", "--label", label, *secret_attrs(config, kind)],
        input=value,
        text=True,
        check=True,
    )


def secret_lookup(config: dict, kind: str) -> str | None:
    result = subprocess.run(
        ["secret-tool", "lookup", *secret_attrs(config, kind)],
        capture_output=True,
        text=True,
    )
    if result.returncode != 0:
        return None
    return result.stdout or None


def secret_clear(config: dict, kind: str) -> None:
    subprocess.run(
        ["secret-tool", "clear", *secret_attrs(config, kind)],
        capture_output=True,
        text=True,
    )


# ------------------------------------------------------------------ DNS
#
# A NAS is usually reached by an mDNS name like nas.local, and on a machine
# whose resolver tries mdns_minimal first that lookup can cost a full timeout
# -- measured at 5.0s here, every time, with no caching anywhere. A status
# refresh makes seven calls, so the panel spent half a minute resolving one
# name it had already resolved six times.
#
# The address is therefore resolved once and remembered briefly. The cache is
# dropped the moment a connection fails, so a NAS that moves to a new DHCP
# lease costs one retry rather than a permanent outage.
DNS_TTL_SECONDS = 600


def _read_dns_cache() -> dict:
    try:
        with open(DNS_PATH, encoding="utf-8") as handle:
            return json.load(handle)
    except (OSError, ValueError):
        return {}


def _write_dns_cache(cache: dict) -> None:
    os.makedirs(CACHE_DIR, mode=0o700, exist_ok=True)
    tmp = DNS_PATH + ".tmp"
    try:
        with open(tmp, "w", encoding="utf-8") as handle:
            json.dump(cache, handle)
        os.replace(tmp, DNS_PATH)
    except OSError:
        pass


def forget_host(host: str) -> None:
    cache = _read_dns_cache()
    if cache.pop(host, None) is not None:
        _write_dns_cache(cache)


def resolve_host(host: str) -> str:
    """The NAS's address, resolved at most once every DNS_TTL_SECONDS."""
    # An address needs no resolving.
    try:
        socket.inet_aton(host)
        return host
    except OSError:
        pass

    cache = _read_dns_cache()
    entry = cache.get(host)
    if isinstance(entry, dict) and float(entry.get("expires", 0)) > time.time():
        return str(entry["ip"])

    # Ask for IPv4 on its own first. A NAS with no AAAA record makes the
    # IPv6 half of a dual lookup wait out the full mDNS timeout -- 5.0s
    # measured against nas.local, while the IPv4 answer was ready in 0.02s.
    # Asking one family at a time skips that wait entirely.
    info = []
    for family in (socket.AF_INET, socket.AF_UNSPEC):
        try:
            info = socket.getaddrinfo(host, None, family, proto=socket.IPPROTO_TCP)
        except socket.gaierror:
            continue
        if info:
            break
    if not info:
        raise SystemExit(f"Cannot resolve {host}")
    ip = info[0][4][0]
    cache[host] = {"ip": ip, "expires": time.time() + DNS_TTL_SECONDS}
    _write_dns_cache(cache)
    return ip


# ------------------------------------------------------------------- TLS


class PinnedContext:
    """TLS for a NAS that almost certainly has a self-signed certificate.

    Turning verification off wholesale is the usual advice and it is wrong:
    it accepts any certificate forever. Instead the first connection records
    the certificate fingerprint and every later one must match it, so a swap
    is visible. The user is trusting one specific certificate rather than
    trusting nothing.
    """

    def __init__(self, config: dict):
        self.pin = config.get("certFingerprint")
        self.verify = bool(config.get("verifyTls", True))

    def build(self) -> ssl.SSLContext:
        ctx = ssl.create_default_context()
        if not self.verify or self.pin:
            ctx.check_hostname = False
            ctx.verify_mode = ssl.CERT_NONE
        return ctx

    @staticmethod
    def fingerprint(host: str, port: int) -> str:
        ctx = ssl.create_default_context()
        ctx.check_hostname = False
        ctx.verify_mode = ssl.CERT_NONE
        with socket.create_connection((resolve_host(host), port), timeout=10) as raw:
            with ctx.wrap_socket(raw, server_hostname=host) as sock:
                der = sock.getpeercert(binary_form=True)
        return hashlib.sha256(der).hexdigest()


# ------------------------------------------------------------------ DSM


class Dsm:
    def __init__(self, config: dict, timeout: float = 20.0):
        self.config = config
        self.host = config.get("host") or ""
        self.port = int(config.get("port") or (5001 if config.get("https", True) else 5000))
        self.https = bool(config.get("https", True))
        self.username = config.get("username") or ""
        self.timeout = timeout
        self.sid: str | None = None
        self.apis: dict[str, dict] = {}
        self._conn: http.client.HTTPConnection | None = None
        self._ctx = PinnedContext(config).build()
        if not self.host:
            raise SystemExit("No NAS configured. Run: omanas configure --host ... --user ...")

    @property
    def base(self) -> str:
        scheme = "https" if self.https else "http"
        return f"{scheme}://{self.host}:{self.port}"

    def _close(self) -> None:
        if self._conn is not None:
            try:
                self._conn.close()
            except OSError:
                pass
            self._conn = None

    def _connect(self) -> http.client.HTTPConnection:
        """One connection per process, reused by every call.

        Besides saving a TLS handshake per request, this is where the pinned
        certificate is actually compared. Recording a fingerprint during setup
        and never checking it again would make the pin decorative.
        """
        if self._conn is not None:
            return self._conn

        address = resolve_host(self.host)
        if self.https:
            conn = http.client.HTTPSConnection(
                address, self.port, timeout=self.timeout, context=self._ctx)
            conn.connect()
            presented = hashlib.sha256(
                conn.sock.getpeercert(binary_form=True)).hexdigest()
            pinned = self.config.get("certFingerprint")
            if pinned and presented != pinned:
                conn.close()
                raise SystemExit(
                    "The NAS certificate does not match the one Omanas pinned.\n"
                    f"  pinned:    {pinned}\n"
                    f"  presented: {presented}\n"
                    "If you replaced the certificate yourself, reconnect from the "
                    "panel to accept the new one."
                )
        else:
            conn = http.client.HTTPConnection(address, self.port, timeout=self.timeout)
            conn.connect()

        self._conn = conn
        return conn

    def _request(self, path: str, query: str = "", body: str | None = None) -> dict:
        target = "/webapi/" + path + (("?" + query) if query else "")
        headers = {
            "User-Agent": "Omanas/0.1 (+https://github.com/Mr-Benedict/omanas)",
            # The connection is made to a cached address, so the name has to
            # travel in the header for DSM's own virtual-host handling.
            "Host": self.host,
        }
        if body is not None:
            headers["Content-Type"] = "application/x-www-form-urlencoded"

        for attempt in (0, 1):
            reused = self._conn is not None
            try:
                conn = self._connect()
                conn.request("POST" if body is not None else "GET", target, body, headers)
                response = conn.getresponse()
                payload = response.read().decode("utf-8", "replace")
            except ssl.SSLError as exc:
                self._close()
                raise SystemExit(describe_tls_failure(exc, self.port))
            except (http.client.HTTPException, OSError) as exc:
                self._close()
                if attempt == 0:
                    # A kept-alive connection the NAS has since dropped just
                    # needs remaking. A first-connection failure may mean the
                    # NAS moved, so the cached address is discarded too.
                    if not reused:
                        forget_host(self.host)
                    continue
                if not self.https and int(self.port) == HTTPS_PORT:
                    raise SystemExit(
                        f"Port {self.port} answered with something that is not HTTP. "
                        "It is probably DSM's HTTPS port — turn HTTPS on.")
                raise SystemExit(f"Cannot reach {self.host}:{self.port} — {exc}")

            if response.status != 200:
                raise SystemExit(f"HTTP {response.status} from {self.host}")
            try:
                return json.loads(payload)
            except ValueError:
                raise SystemExit(f"{self.host} did not return JSON (is the port right?)")
        raise SystemExit(f"Cannot reach {self.host}:{self.port}")

    # The API map is a few hundred entries and changes only when DSM is
    # updated, but it was being fetched on every helper invocation -- the
    # resource poll runs every two seconds and paid for it each time.
    APIS_TTL_SECONDS = 3600

    def _cached_apis(self) -> dict[str, dict] | None:
        try:
            with open(APIS_PATH, encoding="utf-8") as handle:
                cached = json.load(handle)
        except (OSError, ValueError):
            return None
        if cached.get("host") != self.host:
            return None
        if float(cached.get("expires", 0)) < time.time():
            return None
        apis = cached.get("apis")
        return apis if isinstance(apis, dict) and apis else None

    def _store_apis(self, apis: dict) -> None:
        os.makedirs(CACHE_DIR, mode=0o700, exist_ok=True)
        tmp = APIS_PATH + ".tmp"
        try:
            with open(tmp, "w", encoding="utf-8") as handle:
                json.dump({"host": self.host, "apis": apis,
                           "expires": time.time() + self.APIS_TTL_SECONDS}, handle)
            os.replace(tmp, APIS_PATH)
        except OSError:
            pass

    def forget_apis(self) -> None:
        self.apis = {}
        try:
            os.remove(APIS_PATH)
        except OSError:
            pass

    def discover(self, refresh: bool = False) -> dict[str, dict]:
        """Ask DSM which APIs exist, rather than hardcoding paths.

        Paths and version ranges move between DSM releases; SYNO.API.Info is
        the one stable way to find out what this particular NAS offers.
        """
        if self.apis and not refresh:
            return self.apis
        if not refresh:
            cached = self._cached_apis()
            if cached:
                self.apis = cached
                return self.apis
        query = urllib.parse.urlencode(
            {"api": "SYNO.API.Info", "version": "1", "method": "query", "query": "all"}
        )
        body = self._request("query.cgi", query)
        if not body.get("success"):
            raise DsmError(body.get("error", {}).get("code", 0), "SYNO.API.Info", "query")
        self.apis = body.get("data") or {}
        self._store_apis(self.apis)
        return self.apis

    def entry(self, api: str) -> tuple[str, int]:
        """Resolve an API name to its CGI path and a usable version."""
        info = self.discover().get(api)
        if not info:
            # Possibly a cached map from before a DSM update. Pay for one
            # fresh lookup before reporting the API as missing.
            info = self.discover(refresh=True).get(api)
        if not info:
            raise DsmError(102, api, "")
        return str(info.get("path", "entry.cgi")), int(info.get("maxVersion", 1))

    def call(
        self,
        api: str,
        method: str,
        version: int | None = None,
        params: dict | None = None,
        post: bool = False,
    ) -> dict:
        path, max_version = self.entry(api)
        fields = {
            "api": api,
            "method": method,
            "version": str(version if version is not None else max_version),
        }
        fields.update({k: str(v) for k, v in (params or {}).items()})
        if self.sid:
            fields["_sid"] = self.sid
        encoded = urllib.parse.urlencode(fields)
        if post:
            body = self._request(path, body=encoded)
        else:
            body = self._request(path, encoded)
        if not body.get("success"):
            raise DsmError(body.get("error", {}).get("code", 0), api, method)
        return body.get("data") or {}

    # -- session ---------------------------------------------------------

    def load_session(self) -> bool:
        try:
            with open(SESSION_PATH, encoding="utf-8") as handle:
                cached = json.load(handle)
        except (OSError, ValueError):
            return False
        if cached.get("host") != self.host or cached.get("account") != self.username:
            return False
        if float(cached.get("expires", 0)) < time.time():
            return False
        self.sid = cached.get("sid")
        return bool(self.sid)

    def save_session(self) -> None:
        os.makedirs(CACHE_DIR, mode=0o700, exist_ok=True)
        tmp = SESSION_PATH + ".tmp"
        with open(tmp, "w", encoding="utf-8") as handle:
            json.dump(
                {
                    "host": self.host,
                    "account": self.username,
                    "sid": self.sid,
                    # DSM's own default session lifetime is longer, but a
                    # short local expiry costs one cheap re-login and keeps a
                    # stale sid from silently failing every later call.
                    "expires": time.time() + 3600,
                },
                handle,
            )
        os.chmod(tmp, 0o600)
        os.replace(tmp, SESSION_PATH)

    def login(self, otp: str | None = None, force: bool = False,
              password: str | None = None) -> dict:
        """Open a session.

        A caller that already holds the password passes it in, so a credential
        can be proven before it is written anywhere. Everyone else gets it
        from the keyring.
        """
        if not force and self.load_session():
            return {"reused": True}
        if password is None:
            password = secret_lookup(self.config, "password")
        if not password:
            raise SystemExit("No password in the keyring. Run: omanas configure ...")
        params = {
            "account": self.username,
            "passwd": password,
            "session": SESSION_NAME,
            "format": "sid",
            # Ask DSM to hand back a device token so a two-factor account
            # does not demand a fresh code on every login from this machine.
            "enable_device_token": "yes",
        }
        if otp:
            params["otp_code"] = otp
        device_id = secret_lookup(self.config, "device_id")
        if device_id and not otp:
            params["device_id"] = device_id
        # POST so the password never lands in a query string, where DSM's
        # own access log would keep it.
        data = self.call("SYNO.API.Auth", "login", params=params, post=True)
        self.sid = data.get("sid")
        if data.get("did") or data.get("device_id"):
            secret_store(
                self.config,
                "device_id",
                str(data.get("did") or data.get("device_id")),
                f"Omanas device token ({self.host})",
            )
        self.save_session()
        return {"reused": False}

    def logout(self) -> None:
        if self.sid:
            try:
                self.call("SYNO.API.Auth", "logout", params={"session": SESSION_NAME})
            except (DsmError, SystemExit):
                pass
        try:
            os.remove(SESSION_PATH)
        except OSError:
            pass


# ------------------------------------------------------------ redaction
#
# Probe output is meant to be pasted into a bug report or a chat, so it
# describes shapes rather than values: which keys exist and what type each
# holds. Serial numbers, share names and volume paths stay on the NAS.
# Numbers survive verbatim — they say whether a field is bytes, kilobytes or
# a percentage, which is the whole reason to look, and they identify nobody.

# --------------------------------------------------------- normalisation
#
# Everything above talks to DSM. Everything below turns what DSM said into
# one stable shape the QML panel can render.
#
# This layer exists because the panel must not care which DSM version it is
# talking to. Field names here are empirical — taken from open source clients
# that read them off real NASes — so every reader tolerates a missing key, a
# string where a number belongs, and a renamed field, rather than raising.


def as_number(value, default=0.0) -> float:
    """DSM returns sizes as strings, percentages as ints, and gaps as ''."""
    if value is None or value == "":
        return default
    try:
        return float(value)
    except (TypeError, ValueError):
        return default


def first_key(source: dict, *names, default=None):
    """Take whichever spelling of a field this DSM happens to use."""
    for name in names:
        if isinstance(source, dict) and source.get(name) not in (None, ""):
            return source[name]
    return default


def parse_uptime(value) -> int:
    """up_time is seconds on some models and HH:MM:SS on others."""
    if value is None:
        return 0
    text = str(value).strip()
    if text.isdigit():
        return int(text)
    parts = text.split(":")
    if len(parts) == 3 and all(p.strip().isdigit() for p in parts):
        hours, minutes, seconds = (int(p) for p in parts)
        return hours * 3600 + minutes * 60 + seconds
    return 0


def normalise_system(data: dict) -> dict:
    return {
        "model": str(first_key(data, "model", default="")),
        "version": str(first_key(data, "firmware_ver", "version", default="")),
        "uptimeSec": parse_uptime(first_key(data, "up_time", "uptime")),
        "tempC": int(as_number(first_key(data, "sys_temp", "temperature"), 0)),
        "cpuSeries": str(first_key(data, "cpu_series", "cpu_family", default="")),
        "cpuCores": str(first_key(data, "cpu_cores", default="")),
        "ramMb": int(as_number(first_key(data, "ram_size"), 0)),
        # The serial identifies the box; the panel never needs it, so it is
        # reduced to a suffix that is enough to tell two NASes apart.
        "serialSuffix": str(first_key(data, "serial", default=""))[-4:],
    }


def normalise_storage(data: dict) -> dict:
    volumes = []
    for raw in data.get("volumes") or []:
        size = raw.get("size") if isinstance(raw.get("size"), dict) else {}
        total = as_number(first_key(size, "total", default=raw.get("total")))
        used = as_number(first_key(size, "used", default=raw.get("used")))
        volumes.append({
            "id": str(first_key(raw, "id", "name", default="")),
            "label": str(first_key(raw, "display_name", "desc", "id", default="")),
            "status": str(first_key(raw, "status", default="unknown")),
            "fsType": str(first_key(raw, "fs_type", "device_type", default="")),
            "totalBytes": total,
            "usedBytes": used,
            "percent": round(used / total * 100, 1) if total else 0.0,
        })

    disks = []
    for raw in data.get("disks") or []:
        disks.append({
            "id": str(first_key(raw, "id", "device", default="")),
            "name": str(first_key(raw, "name", "model", default="")),
            "status": str(first_key(raw, "status", default="unknown")),
            "smart": str(first_key(raw, "smart_status", "smart_test_status", default="unknown")),
            "tempC": int(as_number(first_key(raw, "temp", "temperature"), 0)),
            # Either threshold tripping is a reason to warn even while SMART
            # still calls the disk healthy.
            "warning": bool(raw.get("exceed_bad_sector_thr") or raw.get("below_remain_life_thr")),
        })

    return {"volumes": volumes, "disks": disks}


def normalise_utilisation(data: dict) -> dict:
    cpu = data.get("cpu") or {}
    memory = data.get("memory") or {}
    network = data.get("network") or []

    # DSM reports CPU as three separate loads rather than one number.
    cpu_percent = sum(
        as_number(cpu.get(key)) for key in ("user_load", "system_load", "other_load")
    )

    total_real = as_number(memory.get("total_real"))
    avail_real = as_number(memory.get("avail_real"))
    if memory.get("real_usage") not in (None, ""):
        mem_percent = as_number(memory.get("real_usage"))
    elif total_real:
        mem_percent = round((total_real - avail_real) / total_real * 100, 1)
    else:
        mem_percent = 0.0

    # The list carries one entry per interface plus a "total" row; prefer the
    # total when DSM provides it rather than double-counting bonded links.
    total_row = next((n for n in network if str(n.get("device", "")).lower() == "total"), None)
    rows = [total_row] if total_row else network
    return {
        "cpuPercent": round(min(cpu_percent, 100.0), 1),
        "memPercent": round(min(mem_percent, 100.0), 1),
        "memTotalBytes": total_real * 1024,
        "netRxBps": sum(as_number(n.get("rx")) for n in rows),
        "netTxBps": sum(as_number(n.get("tx")) for n in rows),
    }


def local_mounts(host: str, mounts_text: str | None = None) -> dict[str, str]:
    """Which of this NAS's shares are mounted here, by share name.

    Read from /proc/self/mounts rather than remembered in a file, so the panel
    still shows the truth after a share is unmounted behind its back.
    """
    found: dict[str, str] = {}
    if mounts_text is not None:
        lines = mounts_text.splitlines()
    else:
        try:
            with open("/proc/self/mounts", encoding="utf-8") as handle:
                lines = handle.read().splitlines()
        except OSError:
            return found
    prefix = f"//{host}/".lower()
    for line in lines:
        fields = line.split()
        if len(fields) < 3 or fields[2] not in ("cifs", "smb3"):
            continue
        source = fields[0].replace("\\040", " ")
        if source.lower().startswith(prefix):
            share = source[len(prefix):]
            found[share] = fields[1].replace("\\040", " ")
    return found


def share_encryption(raw: dict) -> bool:
    """Is this share encrypted?

    DSM answers with a plain flag: encryption is 1 for an encrypted share and
    0 otherwise, on DSM 7.4 at least. It carries no lock state -- an encrypted
    share reads the same whether or not it is currently unlocked, so locked
    has to be established elsewhere. See accessible_shares().
    """
    value = raw.get("encryption")
    if isinstance(value, dict):
        return bool(first_key(value, "encrypted", "is_encrypted", default=False))
    if value in (None, ""):
        return bool(first_key(raw, "is_encrypted", "enc", default=False))
    return as_number(value, 0) > 0


def normalise_shares(data: dict, host: str, accessible: set[str] | None = None) -> list[dict]:
    """Turn a share list into the panel's model.

    `accessible` is the set of shares File Station can see. A locked shared
    folder is not exported, so an encrypted share missing from that set is
    locked. When it is None the lock state is unknown, and the panel offers
    both actions rather than guessing wrong -- which is what sent a mount at
    a locked share and produced a confusing authentication error.
    """
    mounted = local_mounts(host)
    shares = []
    for raw in data.get("shares") or []:
        name = str(first_key(raw, "name", default=""))
        if not name:
            continue
        encrypted = share_encryption(raw)
        if not encrypted:
            locked = False
        elif accessible is None:
            locked = None
        else:
            locked = name not in accessible
        shares.append({
            "name": name,
            "path": str(first_key(raw, "vol_path", "path", default="")),
            "description": str(first_key(raw, "desc", "description", default="")),
            "encrypted": encrypted,
            "locked": locked,
            "hidden": bool(first_key(raw, "hidden", default=False)),
            "readOnly": bool(first_key(raw, "is_force_readonly", default=False)),
            "quotaUsedBytes": as_number(first_key(raw, "share_quota_used")) * 1024 * 1024,
            "mounted": name in mounted,
            "mountpoint": mounted.get(name, ""),
        })
    return sorted(shares, key=lambda s: s["name"].lower())


def accessible_shares(dsm: "Dsm") -> set[str] | None:
    """Shares File Station can actually reach, or None if it cannot say."""
    try:
        data = dsm.call("SYNO.FileStation.List", "list_share", params={"limit": "1000"})
    except (DsmError, SystemExit):
        return None
    rows = data.get("shares")
    if not isinstance(rows, list):
        return None
    return {str(row.get("name")) for row in rows if row.get("name")}


def normalise_logs(data: dict, limit: int) -> list[dict]:
    rows = data.get("items") or data.get("logs") or data.get("data") or []
    if not isinstance(rows, list):
        return []
    out = []
    for raw in rows[:limit]:
        if not isinstance(raw, dict):
            continue
        out.append({
            "level": str(first_key(raw, "level", "type", default="info")).lower(),
            "time": str(first_key(raw, "time", "logtime", "timestamp", default="")),
            "who": str(first_key(raw, "who", "user", default="")),
            "message": str(first_key(raw, "descr", "desc", "message", "event", default="")),
        })
    return out


# ------------------------------------------------------------- commands
#
# Endpoints the panel wants. The first four are well mapped by existing open
# source clients; the last two are the reason `probe` exists, since no public
# source pins down which one a given DSM actually serves.
WANTED = [
    ("system", ["SYNO.Core.System"]),
    ("utilisation", ["SYNO.Core.System.Utilization"]),
    ("storage", ["SYNO.Core.Storage.Volume", "SYNO.Storage.CGI.Storage"]),
    ("shares", ["SYNO.Core.Share"]),
    ("encrypted shares", [
        "SYNO.Core.Share.Crypto",
        "SYNO.Core.Share.Crypto.KeyManager.Store",
        "SYNO.Core.Share.KeyManager.Store",
        "SYNO.Core.Share.KeyManager.AutoKey",
    ]),
    ("logs", [
        "SYNO.Core.SystemLog",
        "SYNO.Core.Log",
        "SYNO.Core.SyslogClient.Log",
        "SYNO.Core.SyslogClient.Status",
        "SYNO.LogCenter.Log",
    ]),
]

# Read-only calls probe may make. Nothing here changes NAS state.
SHARE_PARAMS = {
    "additional": '["hidden","encryption","share_quota","recyclebin","is_force_readonly"]',
    "shareType": "all",
}

PROBE_CALLS = [
    ("SYNO.Core.System", "info", None, {}),
    ("SYNO.Core.System.Utilization", "get", None, {}),
    ("SYNO.Storage.CGI.Storage", "load_info", None, {}),
    ("SYNO.Core.Share", "list", None, SHARE_PARAMS),
    ("SYNO.Core.Share.Crypto", "list", None, {}),
    ("SYNO.Core.SystemLog", "list", None, {"limit": "5", "start": "0"}),
    ("SYNO.Core.Log", "list", None, {"limit": "5", "start": "0"}),
    ("SYNO.Core.SyslogClient.Log", "list", None, {"limit": "5", "start": "0"}),
]


def capabilities(dsm: Dsm) -> dict:
    """Which features this particular NAS can actually support.

    The panel greys out what is missing rather than showing a control that
    fails when pressed, so this is read once per connection and drives the UI.
    """
    apis = dsm.discover()
    logs_api = next((name for name in (
        "SYNO.Core.SystemLog", "SYNO.Core.Log", "SYNO.Core.SyslogClient.Log",
        "SYNO.LogCenter.Log",
    ) if name in apis), "")
    storage_api = next((name for name in (
        "SYNO.Storage.CGI.Storage", "SYNO.Core.Storage.Volume",
    ) if name in apis), "")
    crypto_api = next((name for name in (
        "SYNO.Core.Share.Crypto", "SYNO.Core.Share.Crypto.KeyManager.Store",
    ) if name in apis), "")
    return {
        "system": "SYNO.Core.System" in apis,
        "utilisation": "SYNO.Core.System.Utilization" in apis,
        "storage": storage_api,
        "shares": "SYNO.Core.Share" in apis,
        "crypto": crypto_api,
        "logs": logs_api,
    }


def cmd_connect(args) -> int:
    """Save a NAS and prove the credentials work, in one step.

    The panel calls this from its setup form. Its job is to give the form
    something actionable back: which field was wrong, or that a two-factor
    code is needed, rather than a bare failure.
    """
    config = load_config()
    config["host"] = args.host
    config["username"] = args.user
    config["https"] = not args.no_https
    config["port"] = args.port or (5001 if config["https"] else 5000)

    if config["https"]:
        try:
            fingerprint = PinnedContext.fingerprint(config["host"], int(config["port"]))
        except ssl.SSLError as exc:
            print(json.dumps({"ok": False, "field": "port",
                              "error": describe_tls_failure(exc, config["port"])}))
            return 1
        except OSError as exc:
            print(json.dumps({"ok": False, "field": "host",
                              "error": f"Cannot reach {config['host']}:{config['port']} — {exc}"}))
            return 1
        previous = config.get("certFingerprint")
        if previous and previous != fingerprint and not args.accept_new_cert:
            print(json.dumps({
                "ok": False, "field": "certificate", "certChanged": True,
                "was": previous, "now": fingerprint,
                "error": "The NAS certificate changed since you last connected.",
            }))
            return 1
        config["certFingerprint"] = fingerprint
        config["verifyTls"] = False

    password = sys.stdin.readline().rstrip("\n")
    if not password:
        # Re-verifying an existing NAS: fall back to what is already saved.
        password = secret_lookup(config, "password")
    if not password:
        print(json.dumps({"ok": False, "field": "password", "error": "No password given"}))
        return 1

    # Nothing is written until the credential is proven. A typo should not
    # leave a wrong password sitting in the keyring.
    dsm = Dsm(config)
    try:
        dsm.login(otp=args.otp, force=True, password=password)
    except DsmError as exc:
        field = {400: "password", 403: "otp", 404: "otp", 406: "otp"}.get(exc.code, "")
        # 403 asks for a code, 404 says the code was wrong, 406 says the
        # account requires one. All three need the code field on screen --
        # dropping it on 404 left no way to retype a mistyped code.
        print(json.dumps({
            "ok": False, "code": exc.code, "field": field,
            "needsOtp": exc.code in (403, 404, 406),
            "error": exc.describe(),
        }))
        return 1
    save_config(config)
    secret_store(config, "password", password, f"Omanas DSM password ({config['host']})")
    print(json.dumps({"ok": True, "host": config["host"], "capabilities": capabilities(dsm)}))
    return 0


def cmd_status(args) -> int:
    """One shot of everything the panel shows.

    A section that fails carries its own error instead of sinking the whole
    response — a NAS that refuses the log API should still show its storage.
    """
    config = load_config()
    if not config.get("host"):
        print(json.dumps({"ok": False, "configured": False}))
        return 0

    dsm = Dsm(config)
    try:
        dsm.login()
    except DsmError as exc:
        print(json.dumps({"ok": False, "configured": True, "code": exc.code,
                          "needsOtp": exc.code in (403, 404, 406), "error": exc.describe()}))
        return 1

    caps = capabilities(dsm)
    out: dict = {"ok": True, "configured": True, "host": config["host"],
                 "capabilities": caps, "errors": {}}

    def section(name: str, enabled, call):
        if not enabled:
            return
        try:
            out[name] = call()
        except DsmError as exc:
            out["errors"][name] = exc.describe()
        except SystemExit as exc:
            out["errors"][name] = str(exc)

    section("system", caps["system"],
            lambda: normalise_system(dsm.call("SYNO.Core.System", "info")))
    section("utilisation", caps["utilisation"],
            lambda: normalise_utilisation(dsm.call("SYNO.Core.System.Utilization", "get")))
    section("storage", caps["storage"],
            lambda: normalise_storage(dsm.call(caps["storage"], "load_info")))
    section("shares", caps["shares"],
            lambda: normalise_shares(
                dsm.call("SYNO.Core.Share", "list", params=SHARE_PARAMS, post=True),
                config["host"],
                accessible_shares(dsm)))
    section("logs", caps["logs"],
            lambda: normalise_logs(
                dsm.call(caps["logs"], "list", params={"limit": str(args.logs), "start": "0"}),
                args.logs))

    print(json.dumps(out))
    return 0


def cmd_diagnostics(args) -> int:
    """The report behind the panel's Copy button.

    Always redacted: it describes the shape of each response so a rendering
    bug can be diagnosed, without carrying share names or serial numbers out
    of the user's house.
    """
    config = load_config()
    dsm = Dsm(config)
    report: dict = {"omanas": "0.1.0", "available": {}, "calls": {}}
    apis = dsm.discover()
    report["apiCount"] = len(apis)
    for label, candidates in WANTED:
        report["available"][label] = {
            name: {"path": apis[name].get("path"), "maxVersion": apis[name].get("maxVersion")}
            for name in candidates if name in apis
        } or None
    try:
        dsm.login(otp=args.otp)
    except DsmError as exc:
        report["loginError"] = exc.describe()
        print(json.dumps(report, indent=2, sort_keys=True))
        return 1
    for api, method, version, params in PROBE_CALLS:
        if api not in apis:
            continue
        try:
            data = dsm.call(api, method, version, params, post=(api == "SYNO.Core.Share"))
        except DsmError as exc:
            report["calls"][f"{api}.{method}"] = {"error": exc.code, "message": exc.describe()}
        except SystemExit as exc:
            report["calls"][f"{api}.{method}"] = {"error": "transport", "message": str(exc)}
        else:
            report["calls"][f"{api}.{method}"] = shape(data)
    print(json.dumps(report, indent=2, sort_keys=True))
    return 0


# ----------------------------------------------------------- mounting
#
# The panel asks this helper to mount a share; this helper asks the root
# helper. The chain exists so the SMB password can go from the keyring
# straight into pkexec's stdin without the QML layer ever holding it.

MOUNT_HELPER = os.path.join(os.path.dirname(os.path.abspath(__file__)), "omanas-mount")


def mount_target(config: dict, mount_root: str, share: str) -> str:
    root = os.path.expanduser(mount_root or "~/mnt/nas")
    return os.path.join(root, share)


def run_privileged(arguments: list[str], password: str | None) -> dict:
    """Call the root helper through pkexec, feeding the password on stdin."""
    if not os.path.exists(MOUNT_HELPER):
        return {"ok": False, "error": f"Mount helper missing at {MOUNT_HELPER}"}
    try:
        result = subprocess.run(
            ["pkexec", MOUNT_HELPER, *arguments],
            input=(password + "\n") if password is not None else "",
            capture_output=True,
            text=True,
        )
    except FileNotFoundError:
        return {"ok": False, "error": "pkexec is not installed"}
    if result.stdout.strip():
        try:
            return json.loads(result.stdout.strip().splitlines()[-1])
        except ValueError:
            pass
    if result.returncode == 126:
        # polkit's own code for "the user dismissed the dialog".
        return {"ok": False, "cancelled": True, "error": "Authentication cancelled"}
    if result.returncode == 127:
        return {"ok": False, "error": "pkexec could not run the mount helper"}
    detail = (result.stderr or "").strip().splitlines()
    return {"ok": False, "error": detail[-1] if detail else "Mount helper failed"}


def cmd_mount(args) -> int:
    config = load_config()
    password = secret_lookup(config, "password")
    if not password:
        print(json.dumps({"ok": False, "error": "No password in the keyring"}))
        return 1
    target = mount_target(config, args.mount_root, args.share)
    arguments = [
        "persist" if args.persist else "mount",
        "--host", config["host"],
        "--share", args.share,
        "--mountpoint", target,
        "--account", config["username"],
    ]
    if args.read_only:
        arguments.append("--read-only")
    result = run_privileged(arguments, password)

    # A persisted share is only recorded by 'persist'; mounting it is still a
    # separate step, and one that now needs no password at all.
    if result.get("ok") and args.persist:
        mount = subprocess.run(["mount", target], capture_output=True, text=True)
        if mount.returncode != 0:
            result["mountError"] = (mount.stderr or mount.stdout).strip()
        else:
            result["mounted"] = True

    print(json.dumps(result))
    return 0 if result.get("ok") else 1


def cmd_unmount(args) -> int:
    config = load_config()
    target = mount_target(config, args.mount_root, args.share)
    # An fstab-persisted share carries the 'user' option, so the owner can
    # unmount it without any privilege at all. Try that before asking polkit.
    plain = subprocess.run(["umount", target], capture_output=True, text=True)
    if plain.returncode == 0:
        print(json.dumps({"ok": True, "elevated": False}))
        return 0
    result = run_privileged(["unmount", "--mountpoint", target], None)
    print(json.dumps(result))
    return 0 if result.get("ok") else 1


def cmd_forget(args) -> int:
    config = load_config()
    target = mount_target(config, args.mount_root, args.share)
    result = run_privileged(["forget", "--mountpoint", target, "--share", args.share], None)
    print(json.dumps(result))
    return 0 if result.get("ok") else 1


def cmd_utilisation(args) -> int:
    config = load_config()
    dsm = Dsm(config)
    try:
        dsm.login()
        data = dsm.call("SYNO.Core.System.Utilization", "get")
    except DsmError as exc:
        print(json.dumps({"ok": False, "error": exc.describe()}))
        return 1
    print(json.dumps({"ok": True, "utilisation": normalise_utilisation(data)}))
    return 0


def cmd_unlock(args) -> int:
    """Unlock an encrypted shared folder on the NAS.

    The passphrase arrives on stdin and goes straight out in the POST body.
    It is never an argv element, never written down, and never kept: DSM does
    the decrypting, and the share is then an ordinary share to mount.
    """
    config = load_config()
    dsm = Dsm(config)
    try:
        dsm.login()
    except DsmError as exc:
        print(json.dumps({"ok": False, "error": exc.describe()}))
        return 1

    passphrase = sys.stdin.readline().rstrip("\n")
    if not passphrase:
        print(json.dumps({"ok": False, "error": "No passphrase given"}))
        return 1

    try:
        dsm.call("SYNO.Core.Share.Crypto", "decrypt", post=True,
                 params={"name": args.share, "password": passphrase})
    except DsmError as exc:
        print(json.dumps({"ok": False, "code": exc.code, "error": exc.describe()}))
        return 1
    finally:
        passphrase = ""
    print(json.dumps({"ok": True, "share": args.share}))
    return 0


def cmd_lock(args) -> int:
    """Lock an encrypted shared folder again."""
    config = load_config()
    dsm = Dsm(config)
    try:
        dsm.login()
        dsm.call("SYNO.Core.Share.Crypto", "encrypt", post=True, params={"name": args.share})
    except DsmError as exc:
        print(json.dumps({"ok": False, "code": exc.code, "error": exc.describe()}))
        return 1
    print(json.dumps({"ok": True, "share": args.share}))
    return 0


def read_secret(prompt: str) -> str:
    """Read a secret from a pipe when there is one, otherwise prompt."""
    if not sys.stdin.isatty():
        return sys.stdin.readline().rstrip("\n")
    import getpass

    return getpass.getpass(prompt)


def cmd_configure(args) -> int:
    config = load_config()
    config["host"] = args.host or config.get("host", "")
    config["username"] = args.user or config.get("username", "")
    config["https"] = not args.no_https if args.no_https is not None else config.get("https", True)
    config["port"] = args.port or config.get("port") or (5001 if config["https"] else 5000)
    if not config["host"] or not config["username"]:
        raise SystemExit("Both --host and --user are required the first time")

    if config["https"]:
        try:
            fingerprint = PinnedContext.fingerprint(config["host"], int(config["port"]))
        except Exception as exc:  # noqa: BLE001 - any failure means "cannot pin"
            raise SystemExit(f"Cannot read the TLS certificate: {exc}")
        previous = config.get("certFingerprint")
        if previous and previous != fingerprint and not args.accept_new_cert:
            raise SystemExit(
                "The NAS certificate changed.\n"
                f"  was: {previous}\n"
                f"  now: {fingerprint}\n"
                "If you replaced it yourself, re-run with --accept-new-cert."
            )
        config["certFingerprint"] = fingerprint
        config["verifyTls"] = False
        print(f"Pinned certificate {fingerprint[:16]}…", file=sys.stderr)

    save_config(config)
    password = read_secret(f"DSM password for {config['username']}@{config['host']}: ")
    if not password:
        raise SystemExit("Empty password")
    secret_store(config, "password", password, f"Omanas DSM password ({config['host']})")
    print(json.dumps({"ok": True, "config": CONFIG_PATH}))
    return 0


def cmd_login(args) -> int:
    config = load_config()
    dsm = Dsm(config)
    try:
        result = dsm.login(otp=args.otp, force=args.force)
    except DsmError as exc:
        print(json.dumps({"ok": False, "code": exc.code, "error": exc.describe()}))
        return 1
    print(json.dumps({"ok": True, **result}))
    return 0


def cmd_logout(args) -> int:
    dsm = Dsm(load_config())
    dsm.load_session()
    dsm.logout()
    print(json.dumps({"ok": True}))
    return 0


def cmd_probe(args) -> int:
    """Report what this NAS actually exposes, without leaking what it holds."""
    config = load_config()
    dsm = Dsm(config)
    report: dict = {"dsm": {}, "available": {}, "calls": {}}

    apis = dsm.discover()
    report["dsm"]["apiCount"] = len(apis)

    for label, candidates in WANTED:
        found = {}
        for name in candidates:
            info = apis.get(name)
            if info:
                found[name] = {
                    "path": info.get("path"),
                    "minVersion": info.get("minVersion"),
                    "maxVersion": info.get("maxVersion"),
                }
        report["available"][label] = found or None

    if args.call:
        try:
            dsm.login(otp=args.otp)
        except DsmError as exc:
            print(json.dumps({"ok": False, "code": exc.code, "error": exc.describe()}, indent=2))
            return 1
        for api, method, version, params in PROBE_CALLS:
            if api not in apis:
                continue
            key = f"{api}.{method}"
            try:
                data = dsm.call(api, method, version, params, post=(api == "SYNO.Core.Share"))
            except DsmError as exc:
                report["calls"][key] = {"error": exc.code, "message": exc.describe()}
            except SystemExit as exc:
                report["calls"][key] = {"error": "transport", "message": str(exc)}
            else:
                report["calls"][key] = data if args.raw else shape(data)

    print(json.dumps(report, indent=2, sort_keys=True))
    return 0


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(
        prog="omanas",
        description="Synology DSM client backing the Omanas Omarchy plugin.",
    )
    sub = parser.add_subparsers(dest="command", required=True)

    configure = sub.add_parser("configure", help="Save NAS address and credentials")
    configure.add_argument("--host", help="NAS hostname or IP")
    configure.add_argument("--port", type=int, help="DSM port (default 5001 https / 5000 http)")
    configure.add_argument("--user", help="DSM account name")
    configure.add_argument("--no-https", action="store_true", default=None, help="Use plain HTTP")
    configure.add_argument("--accept-new-cert", action="store_true", help="Accept a changed certificate")
    configure.set_defaults(func=cmd_configure)

    login = sub.add_parser("login", help="Open a DSM session")
    login.add_argument("--otp", help="Two-factor code, if the account needs one")
    login.add_argument("--force", action="store_true", help="Ignore any cached session")
    login.set_defaults(func=cmd_login)

    logout = sub.add_parser("logout", help="Close the DSM session")
    logout.set_defaults(func=cmd_logout)

    connect = sub.add_parser("connect", help="Save a NAS and verify credentials")
    connect.add_argument("--host", required=True)
    connect.add_argument("--port", type=int)
    connect.add_argument("--user", required=True)
    connect.add_argument("--no-https", action="store_true")
    connect.add_argument("--otp")
    connect.add_argument("--accept-new-cert", action="store_true")
    connect.set_defaults(func=cmd_connect)

    status = sub.add_parser("status", help="Everything the panel shows, as JSON")
    status.add_argument("--logs", type=int, default=10)
    status.set_defaults(func=cmd_status)

    utilisation = sub.add_parser("utilisation", help="Just the live resource figures")
    utilisation.set_defaults(func=cmd_utilisation)

    diagnostics = sub.add_parser("diagnostics", help="Redacted report for a bug report")
    diagnostics.add_argument("--otp")
    diagnostics.set_defaults(func=cmd_diagnostics)

    def mount_args(sp):
        sp.add_argument("--share", required=True)
        sp.add_argument("--mount-root", default="~/mnt/nas")

    mount = sub.add_parser("mount", help="Mount a shared folder locally")
    mount_args(mount)
    mount.add_argument("--read-only", action="store_true")
    mount.add_argument("--persist", action="store_true",
                       help="Also add a managed /etc/fstab entry")
    mount.set_defaults(func=cmd_mount)

    unmount = sub.add_parser("unmount", help="Unmount a shared folder")
    mount_args(unmount)
    unmount.set_defaults(func=cmd_unmount)

    forget = sub.add_parser("forget", help="Remove a share's fstab entry")
    mount_args(forget)
    forget.set_defaults(func=cmd_forget)

    unlock = sub.add_parser("unlock", help="Unlock an encrypted shared folder")
    unlock.add_argument("--share", required=True)
    unlock.set_defaults(func=cmd_unlock)

    lock = sub.add_parser("lock", help="Lock an encrypted shared folder again")
    lock.add_argument("--share", required=True)
    lock.set_defaults(func=cmd_lock)

    probe = sub.add_parser("probe", help="Report which APIs this NAS exposes")
    probe.add_argument("--call", action="store_true", help="Also call read-only endpoints")
    probe.add_argument("--raw", action="store_true", help="Print real values instead of shapes")
    probe.add_argument("--otp", help="Two-factor code, if the account needs one")
    probe.set_defaults(func=cmd_probe)

    return parser


def main(argv: list[str] | None = None) -> int:
    args = build_parser().parse_args(argv)
    try:
        return args.func(args)
    except KeyboardInterrupt:
        return 130
    except DsmError as exc:
        print(json.dumps({"ok": False, "code": exc.code, "error": exc.describe()}))
        return 1


if __name__ == "__main__":
    sys.exit(main())
