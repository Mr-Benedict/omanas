{
  "schemaVersion": 1,
  "id": "io.github.mr-benedict.omanas",
  "name": "Omanas",
  "version": "0.1.0",
  "author": "Mr-Benedict",
  "license": "GPL-3.0-or-later",
  "description": "Synology NAS in the Omarchy bar: system health, storage, live resource graphs, recent logs, and one-click mounting of shared folders — including unlocking encrypted ones.",
  "kinds": [
    "bar-widget"
  ],
  "entryPoints": {
    "barWidget": "Panel.qml"
  },
  "barWidget": {
    "displayName": "Omanas",
    "description": "Connect to a Synology NAS to watch health and storage, follow CPU, memory and network in real time, read recent system logs, and mount or unlock shared folders.",
    "category": "Files",
    "allowMultiple": false,
    "defaultSection": "right",
    "defaults": {
      "refreshIntervalSec": 60,
      "resourcePollSec": 3,
      "logCount": 10,
      "mountRoot": "~/mnt/nas",
      "notifications": "on"
    },
    "schema": [
      {
        "key": "refreshIntervalSec",
        "type": "integer",
        "label": "Status refresh interval (seconds)",
        "min": 10,
        "max": 3600,
        "step": 5,
        "defaultValue": 60
      },
      {
        "key": "resourcePollSec",
        "type": "integer",
        "label": "Resource graph interval (seconds, panel open only)",
        "min": 1,
        "max": 30,
        "step": 1,
        "defaultValue": 3
      },
      {
        "key": "logCount",
        "type": "integer",
        "label": "Recent log entries to show",
        "min": 5,
        "max": 100,
        "step": 5,
        "defaultValue": 10
      },
      {
        "key": "mountRoot",
        "type": "string",
        "label": "Shortcut to mounted shares (they live under /mnt/omanas)",
        "defaultValue": "~/mnt/nas"
      },
      {
        "key": "notifications",
        "type": "enum",
        "label": "Desktop notifications",
        "options": [
          { "value": "on", "label": "On" },
          { "value": "off", "label": "Off" }
        ],
        "defaultValue": "on"
      }
    ]
  }
}
